# Career Copilot — .env file (copy to .env and fill in keys)
#
# Required for v0.1: TELEGRAM_BOT_TOKEN, GEMINI_API_KEY, DEEPSEEK_API_KEY, VOYAGE_API_KEY
# Optional for v0.2: TAVILY_API_KEY, FIRECRAWL_API_KEY, GITHUB_TOKEN
# Observability: APPINSIGHTS_CONNECTION_STRING

# ── Telegram ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── LLM ──
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# ── Embedding ──
VOYAGE_API_KEY=

# ── Search + Scrape ──
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# ── GitHub (Contribution Finder) ──
# Fine-grained PAT with Issues: Read-only, All repositories
GITHUB_TOKEN=

# ── Database ──
DATABASE_URL=postgresql+asyncpg://kitan:dev@localhost:5432/career_copilot
# Qdrant Vector DB — use Qdrant Cloud (free tier: 1GB, 1 cluster)
# Sign up at https://qdrant.tech/cloud → create cluster → copy URL + API Key
QDRANT_URL=https://your-cluster-id.aws.cloud.qdrant.io
QDRANT_API_KEY=

# Notion (optional — save papers to Notion DBs)
# NOTION_API_KEY=
# NOTION_PAPERS_DB_ID=
# NOTION_PROFESSORS_DB_ID=


# ── Azure Observability ──
# InstrumentationKey=<guid>;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/
APPINSIGHTS_CONNECTION_STRING=

# ── Optional / Future ──
# SEMANTIC_SCHOLAR_API_KEY=
# NOTION_API_KEY=
# NOTION_PAPERS_DB_ID=
# NOTION_PROFESSORS_DB_ID=
# QDRANT_URL=
# QDRANT_API_KEY=
